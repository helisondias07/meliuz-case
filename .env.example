# Caminho local para o JSON da Service Account.
# Sugestao: salve o arquivo dentro de secrets/ e nunca versione essa credencial.
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service-account.json

# ID da planilha do Google Sheets.
SHEET_ID=

# Nome da aba usada para registrar os testes.
# Se nao for informado, o codigo usa "acompanhamento".
SHEET_TAB_NAME=acompanhamento
